# ==========================================
# Adaptive AI Trading Decision-Support System
# Environment Configuration
# ==========================================

# Core Application Settings
PROJECT_NAME="Adaptive AI Trading Decision-Support System"
ENVIRONMENT="development"
DEBUG=true

# FastAPI Backend Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite:///./trading_intelligence.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/trading_db"

# OpenAI API Key (Optional: system operates in 100% offline deterministic mode if empty)
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o"
MOCK_LLM_IF_NO_KEY=true

# Market Data Default Symbols
DEFAULT_SYMBOLS="AAPL,MSFT,NVDA,GOOGL,AMZN,SPY,QQQ,RELIANCE.NS,TCS.NS"
PRIMARY_BENCHMARK="SPY"
DEFAULT_LOOKBACK_DAYS=365

# Independent Risk Guardian Hard Boundaries
MAX_POSITION_SIZE_PCT=10.0
MAX_SECTOR_EXPOSURE_PCT=25.0
MAX_PORTFOLIO_DRAWDOWN_LIMIT=15.0
MAX_PORTFOLIO_VAR_95=0.03
MIN_CONFIDENCE_THRESHOLD=0.55
MAX_EVIDENCE_CONFLICT_SCORE=0.65
MAX_MODEL_DISAGREEMENT_SCORE=0.60

# Realistic Execution Simulation
DEFAULT_TRANSACTION_COST_BPS=10.0
DEFAULT_SLIPPAGE_BPS=5.0
EXECUTION_DELAY_MINUTES=1

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
PORT=3000
